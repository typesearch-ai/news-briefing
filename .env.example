# typesearch: create a key at https://app.typesearch.ai
TYPESEARCH_API_KEY=

# The model, as provider/model. Defaults to openai/gpt-6-luna.
# MODEL=openai/gpt-6-luna

# Through the Vercel AI Gateway (any model). Not needed on Vercel: the project's OIDC token is used.
AI_GATEWAY_API_KEY=

# Or straight to a provider, with a matching MODEL (openai/… or anthropic/…).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Fictional sample data instead of the API and the model: no keys, no cost. Ignored in Vercel production.
# DEMO_MOCK=1
